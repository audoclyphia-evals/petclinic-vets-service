sequenceDiagram
    participant Caller as "Caller"
    participant Service as "AnalysisService"
    participant DataStore as "DataStore"

    %% Request repository overview
    Caller->>Service: get_repository_overview(repo_id)
    activate Service
    Service->>DataStore: fetch repository overview
    DataStore-->>Service: overview data
    Service->>DataStore: fetch module hierarchy
    DataStore-->>Service: 12 records
    Service->>DataStore: fetch added nodes
    DataStore-->>Service: 52 records
    Service->>DataStore: fetch entry points
    DataStore-->>Service: 8 records
    Service-->>Caller: overview dict
    deactivate Service

    %% Request cluster summaries
    Caller->>Service: get_cluster_summaries(repo_id)
    activate Service
    Service->>DataStore: fetch cluster data
    DataStore-->>Service: cluster records
    Service-->>Caller: summaries records
    deactivate Service